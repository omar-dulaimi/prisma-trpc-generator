{
  "name": "prisma-trpc-generator",
  "version": "2.0.2",
  "description": "Prisma 2+ generator to emit fully implemented tRPC routers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omar-dulaimi/prisma-trpc-generator.git"
  },
  "bin": {
    "prisma-trpc-generator": "lib/generator.js"
  },
  "scripts": {
    "generate": "tsc && npx prisma generate",
    "package:publish": "./package.sh && cd package && npm publish",
    "lint": "eslint src/ --fix",
    "lint:all": "eslint . --fix",
    "format": "prettier --write .",
    "prerelease": "npm run generate && npm run lint",
    "test": "vitest run",
    "semantic-release": "semantic-release",
    "ci:test": "echo 'tests are temporarily disabled'",
    "ci:build": "npm run generate",
    "prepare": "husky"
  },
  "author": {
    "name": "Omar Dulaimi",
    "url": "https://github.com/omar-dulaimi"
  },
  "keywords": [
    "prisma",
    "prisma-client",
    "prisma-schema",
    "prisma-generator",
    "trpc",
    "zod",
    "routers",
    "prisma-trpc-generator"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@prisma/generator-helper": "^6.14.0",
    "@prisma/internals": "^6.14.0",
    "pluralize": "^8.0.0",
    "prisma-trpc-shield-generator": "0.2.1",
    "ts-morph": "^26.0.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.4",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@trpc/server": "^11.5.0",
    "@types/node": "^24.3.0",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "expect-type": "^1.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "prisma-zod-generator": "^1.16.6",
    "semantic-release": "^24.2.7",
    "trpc-shield": "^1.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "7.1.3",
    "vitest": "^3.2.4",
    "zod": "^4.0.17"
  },
  "bugs": {
    "url": "https://github.com/omar-dulaimi/prisma-trpc-generator/issues"
  },
  "homepage": "https://github.com/omar-dulaimi/prisma-trpc-generator#readme",
  "private": true
}
